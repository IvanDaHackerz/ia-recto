{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-managed scoped reviews; never part of an LLM draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_reviews": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "review_kind": {
            "type": "string",
            "enum": [
              "legal_professional_review",
              "software_fixture"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reviewed_on": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "valid_through": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "index_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "policy_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "question_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "component_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "raw_source_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "conditions_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "related_sources_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "currentness_checked": {
            "type": "boolean",
            "const": true
          },
          "conditions_resolved": {
            "type": "boolean",
            "const": true
          },
          "relationships_checked": {
            "type": "boolean",
            "const": true
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          }
        },
        "required": [
          "review_id",
          "review_kind",
          "reviewer",
          "reviewed_on",
          "valid_through",
          "index_version",
          "policy_sha256",
          "question_sha256",
          "component_sha256",
          "rationale",
          "document_id",
          "raw_source_sha256",
          "conditions_sha256",
          "related_sources_sha256",
          "currentness_checked",
          "conditions_resolved",
          "relationships_checked",
          "evidence_urls"
        ],
        "additionalProperties": false
      }
    },
    "claim_reviews": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "review_kind": {
            "type": "string",
            "enum": [
              "legal_professional_review",
              "software_fixture"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reviewed_on": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "valid_through": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "index_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "policy_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "question_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "component_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "claim_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "evidence_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "supports_claim": {
            "type": "boolean",
            "const": true
          },
          "relevant_to_concern": {
            "type": "boolean",
            "const": true
          },
          "qualifications_preserved": {
            "type": "boolean",
            "const": true
          },
          "covers_concern": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "review_id",
          "review_kind",
          "reviewer",
          "reviewed_on",
          "valid_through",
          "index_version",
          "policy_sha256",
          "question_sha256",
          "component_sha256",
          "rationale",
          "claim_sha256",
          "evidence_sha256",
          "supports_claim",
          "relevant_to_concern",
          "qualifications_preserved",
          "covers_concern"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_reviews",
    "claim_reviews"
  ],
  "additionalProperties": false
}
