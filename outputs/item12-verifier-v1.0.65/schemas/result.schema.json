{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item 12 postflight envelope",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "question_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "question_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "mode": {
      "type": "string",
      "enum": [
        "current_guidance",
        "recorded_excerpt"
      ]
    },
    "as_of": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10
    },
    "classifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "index_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "policy_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "review_store_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "software_fixture_mode": {
      "type": "boolean"
    },
    "answer_generation_allowed": {
      "type": "boolean",
      "const": false
    },
    "deployment_allowed": {
      "type": "boolean",
      "const": false
    },
    "display_allowed": {
      "type": "boolean",
      "const": false
    },
    "confidence_meaning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "routing": {
      "type": "object"
    },
    "excluded_components": {
      "type": "array"
    },
    "referral_ids": {
      "type": "array"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "claim_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "object"
    },
    "offline_preview_allowed": {
      "type": "boolean"
    },
    "preview": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "legal_support_verified": {
      "type": "boolean"
    },
    "legal_support_review_recorded": {
      "type": "boolean"
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      }
    },
    "contract_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      }
    }
  },
  "required": [
    "schema_version",
    "verifier_version",
    "question_text",
    "question_sha256",
    "mode",
    "as_of",
    "classifier_version",
    "index_version",
    "policy_sha256",
    "review_store_sha256",
    "software_fixture_mode",
    "answer_generation_allowed",
    "deployment_allowed",
    "display_allowed",
    "confidence_meaning",
    "routing",
    "excluded_components",
    "referral_ids",
    "components",
    "decision",
    "claim_results",
    "coverage",
    "offline_preview_allowed",
    "preview",
    "legal_support_verified",
    "legal_support_review_recorded"
  ],
  "additionalProperties": false
}
