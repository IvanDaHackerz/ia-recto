{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item 12 structured draft (no unchecked free-form answer)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "question_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "source_excerpt",
              "paraphrase"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "chunk_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "provision_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                }
              },
              "required": [
                "chunk_id",
                "provision_id",
                "document_id",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "claim_id",
          "component_id",
          "kind",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "question_text",
    "claims"
  ],
  "additionalProperties": false
}
