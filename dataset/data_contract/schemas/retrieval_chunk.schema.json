{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recto-co.local/schemas/retrieval_chunk.schema.json",
  "title": "Recto & Co. Retrieval Chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "chunking_version",
    "chunk_id",
    "document_id",
    "provision_id",
    "chunk_sequence",
    "chunk_method",
    "subdivision_label",
    "context_prefix",
    "display_text",
    "retrieval_text",
    "normalized_char_start",
    "normalized_char_end",
    "character_count",
    "token_count",
    "tokenizer_name",
    "overlap_previous_tokens",
    "domains",
    "scope_status",
    "supported_topics",
    "excluded_topics",
    "answer_eligible",
    "answer_use_mode",
    "legal_status",
    "status_family",
    "status_as_of",
    "citation_display",
    "quality_flags"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "1.0.0"},
    "chunking_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chunk_id": {"type": "string", "pattern": "^[A-Z0-9_]+__[a-z0-9_]+(?:__[a-z0-9_]+)*__chunk_[0-9]{4}$"},
    "document_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "provision_id": {"type": "string", "minLength": 1},
    "chunk_sequence": {"type": "integer", "minimum": 1},
    "chunk_method": {"type": "string", "enum": ["whole_provision", "natural_subdivision", "token_window_fallback"]},
    "subdivision_label": {"type": ["string", "null"]},
    "context_prefix": {"type": "string", "minLength": 1},
    "display_text": {"type": "string", "minLength": 1},
    "retrieval_text": {"type": "string", "minLength": 1},
    "normalized_char_start": {"type": "integer", "minimum": 0},
    "normalized_char_end": {"type": "integer", "minimum": 1},
    "character_count": {"type": "integer", "minimum": 1},
    "token_count": {"type": ["integer", "null"], "minimum": 1},
    "tokenizer_name": {"type": ["string", "null"]},
    "overlap_previous_tokens": {"type": "integer", "minimum": 0},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["labor", "consumer", "general"]}
    },
    "scope_status": {"type": "string", "enum": ["supported", "excluded", "partial", "review_required"]},
    "supported_topics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "excluded_topics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "answer_eligible": {"type": "boolean"},
    "answer_use_mode": {
      "type": "string",
      "enum": [
        "default_answer",
        "historical_only",
        "time_bound_only",
        "corroboration_only",
        "explanatory_only",
        "blocked_pending_verification",
        "scope_excluded",
        "manual_review_required"
      ]
    },
    "legal_status": {"type": "string", "minLength": 1},
    "status_family": {
      "type": "string",
      "enum": ["current", "current_with_conditions", "historical", "time_bound", "explanatory", "verification_pending"]
    },
    "status_as_of": {"type": "string", "format": "date"},
    "citation_display": {"type": "string", "minLength": 1},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
